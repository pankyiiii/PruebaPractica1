#### 4. Servicio de Sincronización (DbSyncService.cs)
```csharp
using Microsoft.EntityFrameworkCore;
using SistemaHospitalario.Distributed.Models;

namespace SistemaHospitalario.Distributed.Services
{
    public class DbSyncService
    {
        private readonly CentroMedicoContext _context;

        public DbSyncService(CentroMedicoContext context)
        {
            _context = context;
        }

        public async Task SincronizarAsync()
        {
            var logs = await _context.SyncLogs
                .Where(l => !l.Procesado)
                .ToListAsync();
            foreach (var log in logs)
            {
                // Lógica de procesamiento genérico
                log.Procesado = true;
                _context.SyncLogs.Update(log);
            }
            await _context.SaveChangesAsync();
        }
    }
}
```

