#### 3. Contexto EF Core (CentroMedicoContext.cs)
```csharp
using Microsoft.EntityFrameworkCore;
using SistemaHospitalario.Distributed.Models;

namespace SistemaHospitalario.Distributed
{
    public class CentroMedicoContext : DbContext
    {
        public CentroMedicoContext(DbContextOptions<CentroMedicoContext> options)
            : base(options) { }

        public DbSet<Cliente> Clientes { get; set; }
        public DbSet<Consulta> Consultas { get; set; }
        public DbSet<Medico> Medicos { get; set; }
        public DbSet<Especialidad> Especialidades { get; set; }
        public DbSet<CentroMedico> CentrosMedicos { get; set; }
        public DbSet<Empleado> Empleados { get; set; }
        public DbSet<AsignacionEspecialidad> AsignacionEspecialidades { get; set; }
        public DbSet<SyncLog> SyncLogs { get; set; }

        protected override void OnModelCreating(ModelBuilder model)
        {
            // Cliente-Consulta (1:N)
            model.Entity<Consulta>()
                .HasOne(c => c.Cliente)
                .WithMany(c => c.Consultas)
                .HasForeignKey(c => c.ClienteId);

            // Medico-CentroMedico (N:1)
            model.Entity<Medico>()
                .HasOne(m => m.CentroMedico)
                .WithMany(c => c.Medicos)
                .HasForeignKey(m => m.CentroMedicoId);

            // Médico-Especialidad (N:M)
            model.Entity<AsignacionEspecialidad>()
                .HasKey(a => a.AsignacionId);
            model.Entity<AsignacionEspecialidad>()
                .HasOne(a => a.Medico)
                .WithMany(m => m.Asignaciones)
                .HasForeignKey(a => a.MedicoId);
            model.Entity<AsignacionEspecialidad>()
                .HasOne(a => a.Especialidad)
                .WithMany(e => e.Asignaciones)
                .HasForeignKey(a => a.EspecialidadId);
        }
    }
}
```

