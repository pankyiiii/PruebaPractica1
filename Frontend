#### 4. JavaScript

**main.js** (menu y overlay)
```js
const menuBtn = document.getElementById('menu-toggle');
const sidebar = document.querySelector('.sidebar');
const overlay = document.createElement('div');
overlay.className = 'overlay';
document.body.append(overlay);

menuBtn.addEventListener('click', () => {
  sidebar.classList.toggle('collapsed');
  overlay.classList.toggle('active');
});
overlay.addEventListener('click', () => {
  sidebar.classList.remove('collapsed');
  overlay.classList.remove('active');
});
```

**medicos.js**
```js
const apiMedicos = '/api/medicos';
const tableMedicos = document.querySelector('#medicos-table tbody');
const formMedico = document.getElementById('medico-form');
const btnNewMedico = document.getElementById('new-medico');
const inputSearch = document.getElementById('search-medico');
let editId = null;

async function cargarMedicos(query = '') {
  const res = await fetch(apiMedicos + (query ? `?search=${query}` : ''));
  const data = await res.json();
  tableMedicos.innerHTML = data.map(m => `
    <tr>
      <td>${m.medicoId}</td>
      <td>${m.nombre} ${m.apellido}</td>
      <td>${m.telefono}</td>
      <td>
        <button onclick="openEdit(${m.medicoId})">✎</button>
        <button onclick="eliminarMedico(${m.medicoId})">🗑️</button>
      </td>
    </tr>
  `).join('');
}

btnNewMedico.onclick = () => { editId = null; openForm(); };
inputSearch.oninput = e => cargarMedicos(e.target.value);

function openForm() {
  formMedico.classList.add('active');
}
function closeForm() {
  formMedico.classList.remove('active');
  formMedico.reset();
}

document.getElementById('close-medico-form').onclick = closeForm;

formMedico.onsubmit = async e => {
  e.preventDefault();
  const body = {
    nombre: e.target['medico-nombre'].value,
    apellido: e.target['medico-apellido'].value,
    telefono: e.target['medico-telefono'].value
  };
  const method = editId ? 'PUT' : 'POST';
  const url = editId ? `${apiMedicos}/${editId}` : apiMedicos;
  await fetch(url, { method, headers: { 'Content-Type':'application/json' }, body: JSON.stringify(body) });
  closeForm();
  cargarMedicos();
};

async function openEdit(id) {
  editId = id;
  const res = await fetch(`${apiMedicos}/${id}`);
  const m = await res.json();
  formMedico['medico-nombre'].value = m.nombre;
  formMedico['medico-apellido'].value = m.apellido;
  formMedico['medico-telefono'].value = m.telefono;
  openForm();
}

async function eliminarMedico(id) {
  if (!confirm('¿Eliminar este médico?')) return;
  await fetch(`${apiMedicos}/${id}`, { method: 'DELETE' });
  cargarMedicos();
}

document.addEventListener('DOMContentLoaded', () => cargarMedicos());
```

> **Los ficheros** `especialidades.js`, `centros-medicos.js`, `consultas.js`, `clientes.js` y `empleados.js` **siguen la misma estructura**: 
> 1. Selección de tabla y formulario.  
> 2. Funciones `cargarX`, `openEditX`, `eliminarX`, `onsubmit`.  
> 3. Fetch a `/api/X` con GET, POST, PUT, DELETE.

